---
// Sand-colored "get in touch" band shown near the end of each page.
interface Props {
	title: string;
	text: string;
	button: string;
	href?: string;
}

const { title, text, button, href = '/contacto' } = Astro.props;
---

<section class="bg-sand">
	<div class="container cta">
		<div>
			<h2>{title}</h2>
			<p>{text}</p>
		</div>
		<a class="btn btn-deep" href={href}>{button}</a>
	</div>
</section>

<style>
	.cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 28px 48px;
		padding-block: 80px;
	}
	.cta > div {
		flex: 1 1 420px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	h2 {
		margin: 0;
		font-weight: 700;
		font-size: clamp(28px, 3.2vw, 40px);
		line-height: 1.15;
	}
	p {
		font-size: 18px;
	}
</style>
