---
import { SITE_TITLE } from '../consts';

const links = [
	{ href: '/', label: 'Inicio' },
	{ href: '/servicios', label: 'Servicios' },
	{ href: '/proyectos', label: 'Proyectos' },
	{ href: '/nosotros', label: 'Nosotros' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header>
	<div class="container bar">
		<a href="/" class="logo" aria-label={`${SITE_TITLE}, inicio`}>
			<img src="/images/logo-isla-verde.png" alt={SITE_TITLE} width="490" height="462" />
		</a>
		<nav aria-label="Principal">
			{
				links.map((link) => (
					<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
						{link.label}
					</a>
				))
			}
			<a href="/contacto" class="nav-cta" aria-current={isCurrent('/contacto') ? 'page' : undefined}>
				Contacto
			</a>
		</nav>
	</div>
</header>

<style>
	header {
		background: var(--iv-white);
		border-bottom: 4px solid var(--iv-leaf);
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px 32px;
		padding-block: 12px;
	}
	.logo {
		display: block;
		padding: 4px 0;
	}
	.logo img {
		display: block;
		height: 68px;
		width: auto;
		border-radius: 0;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 28px;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 14px;
	}
	nav a {
		color: var(--iv-forest-deep);
		text-decoration: none;
		padding: 12px 0;
		border-bottom: 3px solid transparent;
	}
	nav a:hover {
		color: var(--iv-forest);
	}
	nav a[aria-current='page'] {
		color: var(--iv-forest);
		border-bottom-color: var(--iv-forest);
	}
	nav a.nav-cta {
		padding: 12px 22px;
		border: none;
		border-radius: 8px;
		background: var(--iv-forest-deep);
		color: var(--iv-white);
	}
	nav a.nav-cta:hover {
		background: var(--iv-forest-dark);
		color: var(--iv-white);
	}
	nav a.nav-cta[aria-current='page'] {
		background: var(--iv-sand);
		color: var(--iv-forest-deep);
	}
	@media (max-width: 720px) {
		.bar {
			justify-content: center;
		}
		.logo img {
			height: 56px;
		}
		nav {
			justify-content: center;
			gap: 4px 20px;
		}
	}
</style>
