---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { servicios } from '../data/servicios';
import { proyectos, tagClass } from '../data/proyectos';

// Page content: edit the text here.
const hero = {
	eyebrow: 'Paisajismo y plantas de interior',
	title: 'Espacios verdes para',
	highlight: 'vivir mejor.',
	lede: 'Diseñamos jardines, terrazas y ambientes interiores con plantas para hogares y empresas. Naturales, frescos y fáciles de cuidar.',
	image: '/images/proyectos/jardin_principal.jpeg',
	alt: 'Terraza junto a la piscina con palmas, plantas tropicales y piedra de río',
};

const pasos: { title: string; text: string; icon: IconName }[] = [
	{ title: 'Visita', text: 'Conocemos el lugar, la luz y lo que esperas del espacio.', icon: 'pin' },
	{ title: 'Diseño', text: 'Te proponemos plantas, materas y materiales para tu espacio.', icon: 'pen' },
	{ title: 'Instalación', text: 'Plantamos y dejamos todo listo para disfrutar.', icon: 'sprout' },
	{ title: 'Cuidado', text: 'Te explicamos cómo mantenerlo verde y sano.', icon: 'droplet' },
];

// Projects shown on the home page (titles from src/data/proyectos.ts).
const destacados = ['Lobby con palmas', 'Jardín frontal', 'Materas escultóricas']
	.map((title) => proyectos.find((p) => p.title === title))
	.filter((p) => p !== undefined);

// Look of each service card, in the same order as src/data/servicios.ts.
const cardStyles = [
	{ card: 'card-light', tile: 'tile-forest', border: 'var(--iv-forest)' },
	{ card: 'card-deep', tile: 'tile-sand', border: 'var(--iv-sand)' },
	{ card: 'card-light', tile: 'tile-leaf', border: 'var(--iv-leaf)' },
];
---

<SiteLayout>
	<section class="bg-deep">
		<div class="container hero">
			<div class="hero-text">
				<span class="eyebrow with-line">{hero.eyebrow}</span>
				<h1 class="title-xl">{hero.title} <span class="highlight">{hero.highlight}</span></h1>
				<p class="lede text-on-dark">{hero.lede}</p>
				<div class="btn-row">
					<a class="btn btn-sand" href="/contacto">Solicita una visita</a>
					<a class="btn btn-outline-light" href="/proyectos">Ver proyectos</a>
				</div>
			</div>
			<img class="hero-image" src={hero.image} alt={hero.alt} width="1600" height="900" />
		</div>
	</section>

	<section class="bg-mint section">
		<div class="container">
			<div class="section-head">
				<div>
					<span class="eyebrow">Servicios</span>
					<h2 class="title-lg">Lo que hacemos</h2>
				</div>
				<a class="text-link" href="/servicios">Ver todos los servicios →</a>
			</div>
			<div class="grid">
				{
					servicios.map((servicio, i) => (
						<article class={`service-card ${cardStyles[i].card}`} style={`--top: ${cardStyles[i].border}`}>
							<span class={`icon-tile ${cardStyles[i].tile}`}>
								<Icon name={servicio.icon} size={28} />
							</span>
							<h3>{servicio.title}</h3>
							<p>{servicio.short}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="bg-dark section">
		<div class="container">
			<div class="section-head">
				<div>
					<span class="eyebrow">Cómo trabajamos</span>
					<h2 class="title-lg">De la primera visita a un espacio que crece contigo</h2>
				</div>
			</div>
			<ol class="grid steps" style="--min: 240px">
				{
					pasos.map((paso, i) => (
						<li>
							<span class="step-top">
								<Icon name={paso.icon} size={28} />
								<span class="step-number">{String(i + 1).padStart(2, '0')}</span>
							</span>
							<h3>{paso.title}</h3>
							<p class="text-on-dark">{paso.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-head">
				<div>
					<span class="eyebrow">Proyectos</span>
					<h2 class="title-lg">Trabajos recientes</h2>
				</div>
				<a class="text-link" href="/proyectos">Ver todos los proyectos →</a>
			</div>
			<div class="grid" style="--min: 300px">
				{
					destacados.map((proyecto) => (
						<figure class="project on-dark">
							<img src={proyecto.image} alt={proyecto.alt} loading="lazy" width="900" height="1600" />
							<figcaption>
								{proyecto.title}
								<span class={tagClass(proyecto.category)}>{proyecto.category}</span>
							</figcaption>
						</figure>
					))
				}
			</div>
		</div>
	</section>

	<CtaBand
		title="¿Tienes un espacio que quieres transformar?"
		text="Cuéntanos tu idea y coordinamos una visita."
		button="Escríbenos"
	/>
</SiteLayout>

<style>
	.hero {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 48px 72px;
		padding-block: clamp(64px, 8vw, 88px) clamp(64px, 8vw, 96px);
	}
	.hero-text {
		flex: 1 1 460px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 28px;
	}
	.hero-text .lede {
		max-width: 520px;
	}
	.hero-image {
		flex: 1 1 480px;
		min-width: 0;
		width: 100%;
		height: clamp(320px, 40vw, 540px);
		object-fit: cover;
		border: 6px solid var(--iv-forest);
		box-sizing: border-box;
	}

	.service-card {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 32px;
		border-radius: 16px;
		border-top: 6px solid var(--top);
	}
	.service-card h3 {
		margin: 4px 0 0;
		font-weight: 600;
		font-size: 22px;
		line-height: 1.3;
	}
	.card-light {
		background: var(--iv-white);
	}
	.card-light p {
		color: var(--iv-text-muted);
	}
	.card-deep {
		background: var(--iv-forest-deep);
	}
	.card-deep h3 {
		color: var(--iv-white);
	}
	.card-deep p {
		color: var(--iv-text-on-dark);
	}

	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		gap: 20px;
	}
	.steps li {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 28px;
		border-radius: 16px;
		background: var(--iv-forest-deep);
	}
	.step-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: var(--iv-leaf);
	}
	.step-number {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 28px;
		color: var(--iv-sand);
	}
	.steps h3 {
		margin: 0;
		font-weight: 600;
		font-size: 20px;
	}

	.project {
		margin: 0;
		overflow: hidden;
		border-radius: 16px;
		background: var(--iv-forest-deep);
	}
	.project img {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 4.4;
		object-fit: cover;
		border-radius: 0;
	}
	.project figcaption {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		padding: 18px 22px 22px;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 17px;
		color: var(--iv-white);
	}
</style>
